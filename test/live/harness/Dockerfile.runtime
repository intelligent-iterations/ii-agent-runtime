FROM docker@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe AS docker-tools
FROM node@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7 AS node
FROM ubuntu@sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
COPY --from=node /usr/local/ /usr/local/
COPY --from=docker-tools /usr/local/bin/docker /usr/local/bin/docker
RUN apt-get update && apt-get install --yes --no-install-recommends python3 util-linux e2fsprogs apparmor ca-certificates curl unzip git sudo iptables iproute2 \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global --no-audit --no-fund @openai/codex@0.164.0 \
    && test "$(codex --version)" = 'codex-cli 0.164.0'
ARG TOFU_VERSION=1.12.6
RUN set -eu; \
    curl -fsSLo /tmp/tofu.zip "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_linux_amd64.zip"; \
    curl -fsSLo /tmp/checksums "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_SHA256SUMS"; \
    expected="$(awk -v f="tofu_${TOFU_VERSION}_linux_amd64.zip" '$2==f {print $1}' /tmp/checksums)"; \
    test -n "$expected"; echo "$expected  /tmp/tofu.zip" | sha256sum -c -; \
    unzip /tmp/tofu.zip -d /usr/local/bin; rm /tmp/tofu.zip /tmp/checksums
WORKDIR /app
COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY schemas ./schemas
COPY modules ./modules
RUN npm ci --ignore-scripts --no-audit --no-fund && npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund
COPY test/live/harness/runtime-proof.mjs /app/runtime-proof.mjs
COPY test/live/harness/recovery-proof.mjs /app/recovery-proof.mjs
ENTRYPOINT ["node", "/app/runtime-proof.mjs"]
