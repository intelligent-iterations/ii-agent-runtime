{
  "name": "@intelligent-iterations/ii-agent-runtime",
  "version": "0.1.0",
  "description": "Agent infrastructure: explicit cloud deployment, isolated execution, permissions and deployment records",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts",
    "check": "npm run check:types && npm run typecheck && npm run boundaries && npm test",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "prepare": "npm run build",
    "check:types": "npm run check:runtime-types",
    "generate:runtime-types": "tsx scripts/generate-runtime-types.ts",
    "check:runtime-types": "tsx scripts/generate-runtime-types.ts --check"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./schemas/runtime-configuration.json": "./schemas/runtime-configuration.json",
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./github": {
      "types": "./dist/providers/source/github/index.d.ts",
      "import": "./dist/providers/source/github/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment/index.d.ts",
      "import": "./dist/deployment/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "NOTICE",
    "modules"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "ii-agent-runtime": "dist/deployment/cli.js"
  }
}
