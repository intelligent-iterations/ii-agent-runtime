{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ii-agent-runtime.dev/schemas/setup-v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$"
        },
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 512
        },
        "options": {
          "type": "object",
          "description": "Data-only provider options. Validated by the selected adapter and bound into the setup digest."
        }
      },
      "required": [
        "provider",
        "image",
        "cpu",
        "memoryMiB"
      ]
    },
    "secrets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "const": "github"
              },
              "repository": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "organization": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_-]*$"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              }
            },
            "not": {
              "properties": {
                "environment": {},
                "organization": {}
              },
              "required": [
                "environment",
                "organization"
              ]
            },
            "required": [
              "provider",
              "repository",
              "key"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "not": {
                  "const": "github"
                }
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "provider",
              "resource",
              "key"
            ]
          }
        ]
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      },
      "required": [
        "paths"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "harness",
    "deployment",
    "secrets",
    "capture"
  ]
}
